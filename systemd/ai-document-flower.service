[Unit]
Description=AI Document Processing Celery Flower (Monitoring)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ai_document_processing
Environment="PATH=/var/www/ai_document_processing/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV=/var/www/ai_document_processing/.venv"
EnvironmentFile=/var/www/ai_document_processing/.env

# Start command
ExecStart=/var/www/ai_document_processing/.venv/bin/celery -A app.tasks.celery_app flower --port=5555

# Restart policy
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5

# Resource limits
LimitNOFILE=65536
MemoryLimit=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-doc-flower

[Install]
WantedBy=multi-user.target
