{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invoice Extraction Schema",
  "description": "Schema for extracting structured data from invoices",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice identifier"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Invoice issue date (YYYY-MM-DD)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date (YYYY-MM-DD)"
    },
    "vendor": {
      "type": "object",
      "description": "Vendor/seller information",
      "properties": {
        "name": {
          "type": "string",
          "description": "Vendor company name"
        },
        "address": {
          "type": "string",
          "description": "Vendor address"
        },
        "phone": {
          "type": "string",
          "description": "Vendor phone number"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Vendor email address"
        },
        "tax_id": {
          "type": "string",
          "description": "Vendor tax ID or registration number"
        }
      },
      "required": ["name"]
    },
    "customer": {
      "type": "object",
      "description": "Customer/buyer information",
      "properties": {
        "name": {
          "type": "string",
          "description": "Customer company or person name"
        },
        "address": {
          "type": "string",
          "description": "Customer address"
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address"
        }
      },
      "required": ["name"]
    },
    "line_items": {
      "type": "array",
      "description": "List of invoice line items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Item or service description"
          },
          "quantity": {
            "type": "number",
            "description": "Quantity of items",
            "minimum": 0
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit",
            "minimum": 0
          },
          "amount": {
            "type": "number",
            "description": "Total amount for this line (quantity × unit_price)",
            "minimum": 0
          },
          "tax_rate": {
            "type": "number",
            "description": "Tax rate as percentage (e.g., 10 for 10%)",
            "minimum": 0,
            "maximum": 100
          },
          "tax_amount": {
            "type": "number",
            "description": "Tax amount for this line item",
            "minimum": 0
          }
        },
        "required": ["description", "quantity", "unit_price", "amount"]
      },
      "minItems": 1
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal before taxes and discounts",
      "minimum": 0
    },
    "tax_total": {
      "type": "number",
      "description": "Total tax amount",
      "minimum": 0
    },
    "discount": {
      "type": "number",
      "description": "Discount amount",
      "minimum": 0,
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "description": "Final total amount to pay",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "description": "Currency code (USD, EUR, GBP, etc.)",
      "pattern": "^[A-Z]{3}$"
    },
    "payment_terms": {
      "type": "string",
      "description": "Payment terms and conditions"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or comments"
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "vendor",
    "customer",
    "line_items",
    "total_amount",
    "currency"
  ]
}
