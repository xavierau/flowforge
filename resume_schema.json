{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume/CV Extraction Schema",
  "description": "Schema for extracting structured data from resumes and CVs",
  "type": "object",
  "properties": {
    "personal_info": {
      "type": "object",
      "description": "Personal information of the candidate",
      "properties": {
        "full_name": {
          "type": "string",
          "description": "Candidate's full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone number"
        },
        "location": {
          "type": "object",
          "description": "Current location",
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          }
        },
        "linkedin": {
          "type": "string",
          "format": "uri",
          "description": "LinkedIn profile URL"
        },
        "github": {
          "type": "string",
          "format": "uri",
          "description": "GitHub profile URL"
        },
        "portfolio": {
          "type": "string",
          "format": "uri",
          "description": "Portfolio or personal website URL"
        }
      },
      "required": ["full_name"]
    },
    "professional_summary": {
      "type": "string",
      "description": "Professional summary or objective statement"
    },
    "work_experience": {
      "type": "array",
      "description": "Work history and professional experience",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "description": "Company or organization name"
          },
          "position": {
            "type": "string",
            "description": "Job title or position held"
          },
          "location": {
            "type": "string",
            "description": "Work location (city, country)"
          },
          "start_date": {
            "type": "string",
            "description": "Start date (e.g., 'Jan 2020', '2020-01', 'January 2020')"
          },
          "end_date": {
            "type": "string",
            "description": "End date or 'Present' for current position"
          },
          "responsibilities": {
            "type": "array",
            "description": "Key responsibilities and achievements",
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "description": "Technologies, tools, or frameworks used",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["company", "position", "start_date"]
      },
      "minItems": 1
    },
    "education": {
      "type": "array",
      "description": "Educational background",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string",
            "description": "School, college, or university name"
          },
          "degree": {
            "type": "string",
            "description": "Degree or certification obtained"
          },
          "field_of_study": {
            "type": "string",
            "description": "Major or field of study"
          },
          "location": {
            "type": "string",
            "description": "Institution location"
          },
          "graduation_date": {
            "type": "string",
            "description": "Graduation date or expected graduation"
          },
          "gpa": {
            "type": "string",
            "description": "GPA or grade (if mentioned)"
          },
          "honors": {
            "type": "array",
            "description": "Academic honors, awards, or distinctions",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["institution", "degree"]
      },
      "minItems": 1
    },
    "skills": {
      "type": "object",
      "description": "Technical and soft skills",
      "properties": {
        "technical_skills": {
          "type": "array",
          "description": "Programming languages, frameworks, tools, technologies",
          "items": {
            "type": "string"
          }
        },
        "soft_skills": {
          "type": "array",
          "description": "Interpersonal and professional soft skills",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "description": "Spoken/written languages and proficiency levels",
          "items": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "proficiency": {
                "type": "string",
                "description": "e.g., Native, Fluent, Professional, Intermediate, Basic"
              }
            },
            "required": ["language"]
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "description": "Professional certifications and licenses",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Certification name"
          },
          "issuing_organization": {
            "type": "string",
            "description": "Organization that issued the certification"
          },
          "issue_date": {
            "type": "string",
            "description": "Date certification was obtained"
          },
          "expiry_date": {
            "type": "string",
            "description": "Expiration date (if applicable)"
          },
          "credential_id": {
            "type": "string",
            "description": "Credential or certificate ID"
          },
          "credential_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to verify certification"
          }
        },
        "required": ["name"]
      }
    },
    "projects": {
      "type": "array",
      "description": "Notable projects or portfolio items",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name or title"
          },
          "description": {
            "type": "string",
            "description": "Brief project description"
          },
          "role": {
            "type": "string",
            "description": "Your role in the project"
          },
          "technologies": {
            "type": "array",
            "description": "Technologies used",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Project URL or demo link"
          },
          "date": {
            "type": "string",
            "description": "Project completion date or time period"
          }
        },
        "required": ["name"]
      }
    },
    "publications": {
      "type": "array",
      "description": "Research papers, articles, or publications",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Publication title"
          },
          "authors": {
            "type": "array",
            "description": "List of authors",
            "items": {
              "type": "string"
            }
          },
          "publication_venue": {
            "type": "string",
            "description": "Journal, conference, or publication venue"
          },
          "publication_date": {
            "type": "string",
            "description": "Publication date"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Link to publication"
          },
          "doi": {
            "type": "string",
            "description": "Digital Object Identifier"
          }
        },
        "required": ["title"]
      }
    },
    "awards_and_honors": {
      "type": "array",
      "description": "Professional awards, honors, and recognitions",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Award or honor title"
          },
          "issuer": {
            "type": "string",
            "description": "Organization that issued the award"
          },
          "date": {
            "type": "string",
            "description": "Date received"
          },
          "description": {
            "type": "string",
            "description": "Brief description or reason for award"
          }
        },
        "required": ["title"]
      }
    },
    "volunteer_experience": {
      "type": "array",
      "description": "Volunteer work and community involvement",
      "items": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Organization name"
          },
          "role": {
            "type": "string",
            "description": "Volunteer role or position"
          },
          "start_date": {
            "type": "string",
            "description": "Start date"
          },
          "end_date": {
            "type": "string",
            "description": "End date or 'Present'"
          },
          "description": {
            "type": "string",
            "description": "Brief description of volunteer work"
          }
        },
        "required": ["organization", "role"]
      }
    },
    "interests": {
      "type": "array",
      "description": "Professional interests and hobbies",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "personal_info",
    "work_experience",
    "education",
    "skills"
  ]
}
