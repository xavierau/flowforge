{
  "name": "test_simple_extraction",
  "description": "Simple single-task extraction workflow for testing",
  "version": 1,
  "schemaVersion": 2,
  "inputParameters": ["document_id", "schema", "tenant_id"],
  "outputParameters": {
    "extracted_data": "${extract_document.output.extracted_data}",
    "confidence_score": "${extract_document.output.confidence_score}",
    "pages_processed": "${extract_document.output.pages_processed}"
  },
  "tasks": [
    {
      "name": "extract_document",
      "taskReferenceName": "extract_document",
      "type": "SIMPLE",
      "inputParameters": {
        "document_id": "${workflow.input.document_id}",
        "schema": "${workflow.input.schema}",
        "tenant_id": "${workflow.input.tenant_id}",
        "provider": "google",
        "model": "gemini-2.5-flash"
      }
    }
  ],
  "restartable": true,
  "workflowStatusListenerEnabled": true,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 600
}
